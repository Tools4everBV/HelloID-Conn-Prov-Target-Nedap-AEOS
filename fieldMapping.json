            "Update"
          ],
          "MappingMode": "Complex",
          "Value": "\"function getEmail() {\\n    let mail = '';\\n        if (typeof Person.Accounts.MicrosoftActiveDirectory.mail !== 'undefined' && Person.Accounts.MicrosoftActiveDirectory.mail) {\\n            mail = Person.Accounts.MicrosoftActiveDirectory.mail;\\n        } return mail;\\n    }\\ngetEmail()\"",
