      "Name": "Gender",
      "Description": "Gender: Male, Female, Unknown",
      "Type": "Text",
      "MappingActions": [
        {
          "MapForActions": [
            "Create",
            "Update"
          ],
          "MappingMode": "Complex",
          "Value": "\"function getValue() {\\n    let gender\\n    switch (Person.Details.Gender) {\\n        case \\\"Man\\\":\\n            gender = 'Male'\\n            break\\n        case \\\"Vrouw\\\":\\n            gender = 'Female'\\n            break\\n        default:\\n            gender = \\\"Unknown\\\"\\n    }\\n    return gender\\n}\\ngetValue();\"",
          "UsedInNotifications": false,
          "StoreInAccountData": false
        }
      ]
    },
